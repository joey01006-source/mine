{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Voxel: run Rust terrain generator",
      "type": "process",
      "command": "cargo",
      "args": [
        "run",
        "--release",
        "--locked",
        "--",
        "42",
        "48",
        "world"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$rustc"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Voxel: test Rust",
      "type": "process",
      "command": "cargo",
      "args": [
        "test",
        "--locked"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "test",
      "problemMatcher": [
        "$rustc"
      ]
    }
  ]
}
