{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Voxel: build and run C++",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/voxel",
      "args": ["42", "48", "world"],
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Voxel: build",
      "stopAtEntry": false,
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "gdb",
      "windows": {
        "program": "${workspaceFolder}/voxel.exe",
        "miDebuggerPath": "gdb.exe"
      },
      "osx": {
        "MIMode": "lldb",
        "miDebuggerPath": "lldb"
      }
    }
  ]
}
